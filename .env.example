# Resend API authentication
RESEND_API_KEY=re_your_resend_api_key

# Email report settings
REPORT_TO_EMAIL=your-email@example.com
REPORT_FROM_EMAIL="Website Alerts <onboarding@resend.dev>"

# Protects the manual report endpoint
ADMIN_TOKEN=create_a_long_random_token

# Optional: comma-separated IP addresses that should not be tracked
EXCLUDED_IPS=192.0.2.10,192.0.2.11
